%%  Copyright (c) 2025 Franka Robotics GmbH
%%  Franka Torque Control Block - TLC Implementation
%%
%%  This TLC generates code where the libfranka control callback
%%  directly executes the function-call subsystem (user's controller).
%%
%%  robot_ip is provided via input port 1 (not as a parameter).
%%
%implements "franka_torque_control" "C"

%% ========================================================================
%% BlockTypeSetup - Called once per block type
%% ========================================================================
%function BlockTypeSetup(block, system) void
    %<LibAddToCommonIncludes("franka_torque_control_api.h")>
%endfunction

%% ========================================================================
%% BlockInstanceSetup - Called once per block instance
%% Declares global variables
%% ========================================================================
%function BlockInstanceSetup(block, system) Output
{
    %openfile buffer
    
    /* Franka Torque Control Context */
    FrankaTorqueControlContext franka_ctx;

    %closefile buffer
    %<LibCacheGlobalPrmData(buffer)>
}
%endfunction

%% ========================================================================
%% Start - Initialization code
%% ========================================================================
%function Start(block, system) Output
{
    /* Initialize Franka Torque Control Context */
    /* robot_ip comes from input port 1 as ASCII string (null-terminated) */
    franka_ctx.initialize(reinterpret_cast<const char*>(%<LibBlockInputSignalAddr(1, "", "", 0)>));

    /* Register controller callback (1kHz, libfranka control thread).
     *
     * We intentionally avoid LibGetFcnCallISR/LibBlockExecuteFcnCall here:
     * those require TLC driver-scoped symbols (e.g. BlockIdx/BlockId) and/or
     * can expand to inline code that depends on the model-step context.
     *
     * Instead, we call the generated Controller *member function* on the
     * current model instance ("this") via a free-function trampoline.
     *
     * Requirements:
     * - The function-call subsystem (Controller) must be generated as a callable
     *   function (not fully inlined into step). In C++ class interface mode,
     *   this will typically be a method like: this->motion_with_control_Controller().
     */
    %assign callIdx = 0
    %assign recIdx = block.SFcnSystemOutputCallMappingInfo[callIdx].StartingIdx
    %assign dstSSBlk = LibGetFcnCallBlock(block, recIdx)
    %if !LibIsEqual(dstSSBlk, "")
        %with dstSSBlk
            %assign ctrlSysIdx = LibBlockParamSetting("Subsystem", "SystemIdx")
        %endwith
        %assign ctrlFcnName = ::CompiledModel.System[ctrlSysIdx].OutputUpdateFcn
        %if !LibIsEqual(ctrlFcnName, "")
            franka_ctx.setControllerCallback(
                +[](void* user_data) {
                    auto self = static_cast<decltype(this)>(user_data);
                    self->%<ctrlFcnName>();
                },
                this
            );
        %endif
    %endif
    
    /* Set pointers to Simulink I/O signals */
    franka_ctx.setOutputPointers(
        %<LibBlockOutputSignalAddr(1, "", "", 0)>,   /* q [7] */
        %<LibBlockOutputSignalAddr(2, "", "", 0)>    /* dq [7] */
    );
    franka_ctx.setInputPointers(
        %<LibBlockInputSignalAddr(2, "", "", 0)>     /* tau_J_d [7] - port 2 */
    );
    
    /* Initialize DWork state */
    %<LibBlockDWork(PrevEnable, "", "", 0)> = 0.0;
}
%endfunction

%% ========================================================================
%% Outputs - Called by Simulink scheduler (for enable/disable handling)
%% The actual 1kHz control happens inside robot.control(), not here
%% ========================================================================
%function Outputs(block, system) Output
{
    /* Franka Torque Control Block */
    
    /* Get enable input */
    real_T enable = %<LibBlockInputSignal(0, "", "", 0)>;
    real_T prev_enable = %<LibBlockDWork(PrevEnable, "", "", 0)>;
    
    /* Edge detection */
    bool rising_edge = (enable > 0.5) && (prev_enable <= 0.5);
    bool falling_edge = (enable <= 0.5) && (prev_enable > 0.5);
    
    /* Update previous enable */
    %<LibBlockDWork(PrevEnable, "", "", 0)> = enable;
    
    /* Handle state transitions */
    if (rising_edge && !franka_ctx.isControlRunning()) {
        /* Start control loop on rising edge */
        franka_ctx.startControl();
    }
    else if (falling_edge && franka_ctx.isControlRunning()) {
        /* Request stop on falling edge (graceful) */
        franka_ctx.requestStop();
    }
}
%endfunction

%% ========================================================================
%% Terminate - Cleanup code
%% ========================================================================
%function Terminate(block, system) Output
{
    /* Shutdown Franka control */
    franka_ctx.shutdown();
}
%endfunction
