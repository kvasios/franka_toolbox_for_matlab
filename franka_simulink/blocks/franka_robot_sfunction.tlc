%%  Copyright (c) 2025 Franka Robotics GmbH
%%  Franka Robot Block - TLC Implementation
%%
%%  This TLC generates code where the libfranka control callback
%%  directly executes the function-call subsystem (user's controller).
%%
%%  Supports multiple control modes:
%%
%%  Single-callback modes (internal controller for non-torque):
%%    0: Torques           - Direct torque control
%%    1: JointPositions    - Joint position with internal impedance
%%    2: JointVelocities   - Joint velocity with internal impedance
%%    3: CartesianPose     - Cartesian pose with internal impedance
%%    4: CartesianVelocities - Cartesian velocity with internal impedance
%%
%%  Dual-callback modes (user torque + motion generator):
%%    5: Torques + JointPositions      - External torque + joint pos motion gen
%%    6: Torques + JointVelocities     - External torque + joint vel motion gen
%%    7: Torques + CartesianPose       - External torque + Cartesian pose motion gen
%%    8: Torques + CartesianVelocities - External torque + Cartesian vel motion gen
%%
%%  robot_ip is provided via input port 1 (not as a parameter).
%%  control_mode is provided via S-function parameter.
%%
%implements "franka_robot_sfunction" "C"

%% ========================================================================
%% BlockTypeSetup - Called once per block type
%% ========================================================================
%function BlockTypeSetup(block, system) void
    %<LibAddToCommonIncludes("franka_robot_api.h")>
    %<LibAddToCommonIncludes("franka_simulink_types.h")>
    %<LibAddToCommonIncludes("<type_traits>")>
    %<LibAddToCommonIncludes("<cstring>")>
    %<LibAddToCommonIncludes("<iostream>")>
%endfunction

%% ========================================================================
%% BlockInstanceSetup - Called once per block instance
%% Declares global variables
%% ========================================================================
%function BlockInstanceSetup(block, system) Output
{
    %openfile buffer
    
    /* Franka Robot Context (per block instance).
     *
     * Each block gets its own FrankaRobotContext to manage I/O pointers and
     * callbacks. Multiple contexts targeting the same robot IP share the
     * underlying connection via FrankaRobotManager (singleton registry).
     */
    %assign ctxName = "franka_ctx_" + FEVAL("num2str", block.BlockIdx[0]) + "_" + FEVAL("num2str", block.BlockIdx[2])
    FrankaRobotContext %<ctxName>;

    %closefile buffer
    %<LibCacheGlobalPrmData(buffer)>
}
%endfunction

%% ========================================================================
%% Start - Initialization code
%% ========================================================================
%function Start(block, system) Output
{
    %assign ctxName = "franka_ctx_" + FEVAL("num2str", block.BlockIdx[0]) + "_" + FEVAL("num2str", block.BlockIdx[2])
    
    %% Read control mode from S-function parameter settings
    %assign controlMode = CAST("Number", SFcnParamSettings.ControlMode)
    
    /* NOTE:
     * Do NOT connect to the robot in Start().
     *
     * In generated code, upstream blocks that produce the robot_ip bytes (e.g.
     * String Constant -> String to ASCII) often compute their outputs in step(),
     * not in initialize(). At Start() time, the block I/O struct is typically
     * still zeroed, so reading the robot_ip input port here can yield an empty
     * string (=> libfranka "No address found").
     *
     * We connect lazily on the enable rising edge in Outputs(), after the model
     * has produced valid robot_ip bytes for the current step.
     */
    
    /* Set control mode: %<controlMode> */
    %<ctxName>.setControlMode(static_cast<FrankaControlMode>(%<controlMode>));

    /* Resolve the function-call subsystem entry-point we should invoke from the
     * libfranka 1kHz callback.
     */
    %assign callIdx = 0
    %assign recIdx = block.SFcnSystemOutputCallMappingInfo[callIdx].StartingIdx
    %assign dstSSBlk = LibGetFcnCallBlock(block, recIdx)
    %if !LibIsEqual(dstSSBlk, "")
        %with dstSSBlk
            %assign ctrlSysIdx = LibBlockParamSetting("Subsystem", "SystemIdx")
        %endwith

        %% Get the properly mangled function name from FcnInfo records.
        %% This is critical for ERT targets where identifier length limits
        %% cause additional truncation beyond what's stored in OutputUpdateFcn.
        %assign ctrlSys = ::CompiledModel.System[ctrlSysIdx]
        %assign ctrlFcnName = ""
        %if LibIsSystemField(ctrlSys, "OutputUpdateFcnInfo")
            %assign ouFcnInfo = LibGetSystemField(ctrlSys, "OutputUpdateFcnInfo")
            %if !LibIsEqual(ouFcnInfo, "")
                %assign ctrlFcnName = ouFcnInfo.Name
            %endif
        %endif
        %% Fallback to OutputFcnInfo if OutputUpdate not found
        %if LibIsEqual(ctrlFcnName, "") && LibIsSystemField(ctrlSys, "OutputFcnInfo")
            %assign outFcnInfo = LibGetSystemField(ctrlSys, "OutputFcnInfo")
            %if !LibIsEqual(outFcnInfo, "")
                %assign ctrlFcnName = outFcnInfo.Name
            %endif
        %endif
        %if !LibIsEqual(ctrlFcnName, "")
            %if GenerateClassInterface
                /* C++ class interface packaging:
                 * Create a dedicated controller model object that is ONLY touched by
                 * the libfranka 1kHz control thread. This avoids races with the main
                 * scheduler running the top-level model (enable/disable, logging, etc.).
                 */
                using FrankaControllerModelT = std::remove_reference<decltype(*this)>::type;
                static FrankaControllerModelT franka_controller_model;

                /* Initialize controller-model timing/state. The dedicated controller
                 * instance is NOT run by the Simulink scheduler, so we explicitly
                 * initialize its timing fields and advance its timebase in the callback.
                 *
                 * Note: ERT and GRT targets have different timing structure layouts:
                 * - GRT: Has clockTick0, clockTickH0 (64-bit counter), stepSize0, taskTime0, tFinal
                 * - ERT: May only have clockTick0 (32-bit counter), stopRequestedFlag, errorStatus
                 * We use conditional compilation to handle both.
                 */
                {
                    auto* rtm = franka_controller_model.getRTM();
                    %if !SLibIsERTTarget()
                    /* GRT target: Full timing structure available */
                    rtm->Timing.stepSize0 = 0.001;  /* 1kHz nominal */
                    rtm->Timing.taskTime0 = 0.0;
                    rtm->Timing.clockTick0 = 0U;
                    rtm->Timing.clockTickH0 = 0U;
                    rtm->Timing.stopRequestedFlag = false;
                    rtm->Timing.tFinal = -1;
                    %else
                    /* ERT target: Compact timing structure */
                    rtm->Timing.clockTick0 = 0U;
                    %endif
                    rtm->errorStatus = nullptr;
                }

                %<ctxName>.setControllerCallback(
                    +[](void* user_data, double dt_sec) {
                        auto ctrl = static_cast<decltype(this)>(user_data);
                        (void)dt_sec;  /* Suppress unused warning for ERT */

                        /* Advance controller-model timebase FIRST (libfranka convention). */
                        {
                            auto* rtm = ctrl->getRTM();
                            %if !SLibIsERTTarget()
                            /* GRT: Track elapsed time and use 64-bit tick counter */
                            if (dt_sec > 0.0) {
                                rtm->Timing.taskTime0 += dt_sec;
                            }
                            if (!(++rtm->Timing.clockTick0)) {
                                ++rtm->Timing.clockTickH0;
                            }
                            %else
                            /* ERT: Use 32-bit tick counter only */
                            ++rtm->Timing.clockTick0;
                            %endif
                        }

                        /* Now run the controller with the updated time */
                        ctrl->%<ctrlFcnName>();
                    },
                    &franka_controller_model
                );
            %else
                /* Nonreusable function packaging (External Mode friendly):
                 *
                 * There is no model object / 'this' context. The controller entry-point
                 * is a normal function that operates on the generated global model data.
                 *
                 * IMPORTANT: We do NOT manually advance the model timebase here because
                 * the main scheduler already advances the global RTM timing each step.
                 * Advancing it here would double-count time.
                 */
                %<ctxName>.setControllerCallback(
                    +[](void* /*user_data*/, double /*dt_sec*/) {
                        %<ctrlFcnName>();
                    },
                    nullptr
                );
            %endif
        %endif
        %if LibIsEqual(ctrlFcnName, "")
            /*
             * ERROR: Could not resolve a callable entry point for the function-call subsystem.
             *
             * This happens when the targeted subsystem is inlined or otherwise not
             * generated as a callable function (no OutputUpdateFcnInfo or OutputFcnInfo found).
             *
             * Fix in model:
             * - Ensure the function-call subsystem is atomic and generates a callable function
             *   (not fully inlined into step).
             */
            #error "franka_robot: could not resolve function-call subsystem entry point (no FcnInfo found). Make the Controller subsystem callable (not inlined)."
        %endif

        /* Wire Franka <-> Simulink signals.
         * 
         * Output port layout:
         *   Port 0: Function-call (no data)
         *   Port 1: robot_state (FrankaRobotStateBus struct)
         *   Port 2: model_data (FrankaModelDataBus struct)
         *   Port 3: dt_sec (double)
         * 
         * Input port layout (mode-dependent):
         *   Common (all modes):
         *     Port 0: Enable
         *     Port 1: robot_ip
         *     Port 2: settings (FrankaRobotSettingsBus)
         *     Port 3: error_recovery (trigger)
         *     Port 4: read_once (trigger)
         *   Single modes (0-4):
         *     Port 5: command (tau_J_d / q_d / dq_d / O_T_EE_d / O_dP_EE_d)
         *     Port 6: elbow_d (only for Cartesian modes 3-4)
         *   Dual modes (5-8):
         *     Port 5: tau_J_d
         *     Port 6: motion_cmd (q_d / dq_d / O_T_EE_d / O_dP_EE_d)
         *     Port 7: elbow_d (only for Cartesian modes 7-8)
         */
        %assign bsMember = "%<::CompiledModel.Name>_B"
        %assign stateExpr = "%<LibBlockOutputSignalAddr(1, "", "", 0)>"
        %assign modelExpr = "%<LibBlockOutputSignalAddr(2, "", "", 0)>"
        %assign dtExpr = "%<LibBlockOutputSignalAddr(3, "", "", 0)>"
        
        %% Settings bus is always at port 2
        %assign settingsExpr = "%<LibBlockInputSignalAddr(2, "", "", 0)>"
        
        %% Assign input expressions based on mode (ports shifted by 2 for error_recovery/read_once)
        %if controlMode <= 4
            %% Single-callback modes: Port 5 = command
            %assign cmdExpr = "%<LibBlockInputSignalAddr(5, "", "", 0)>"
            %if controlMode == 3 || controlMode == 4
                %assign elbowExpr = "%<LibBlockInputSignalAddr(6, "", "", 0)>"
            %endif
        %else
            %% Dual-callback modes: Port 5 = tau_J_d, Port 6 = motion_cmd
            %assign tauExpr = "%<LibBlockInputSignalAddr(5, "", "", 0)>"
            %assign motionExpr = "%<LibBlockInputSignalAddr(6, "", "", 0)>"
            %if controlMode == 7 || controlMode == 8
                %assign elbowExpr = "%<LibBlockInputSignalAddr(7, "", "", 0)>"
            %endif
        %endif

        %if GenerateClassInterface
            /* In class interface packaging, redirect I/O to the dedicated controller object. */
            %assign fromPrefix = "&%<bsMember>."
            %assign toPrefix = "&franka_controller_model.%<bsMember>."
            %assign stateExprCtrl = FEVAL("strrep", stateExpr, fromPrefix, toPrefix)
            %assign modelExprCtrl = FEVAL("strrep", modelExpr, fromPrefix, toPrefix)
            %assign dtExprCtrl = FEVAL("strrep", dtExpr, fromPrefix, toPrefix)
            %assign settingsExprCtrl = FEVAL("strrep", settingsExpr, fromPrefix, toPrefix)
            %if controlMode <= 4
                %assign cmdExprCtrl = FEVAL("strrep", cmdExpr, fromPrefix, toPrefix)
                %if controlMode == 3 || controlMode == 4
                    %assign elbowExprCtrl = FEVAL("strrep", elbowExpr, fromPrefix, toPrefix)
                %endif
            %else
                %assign tauExprCtrl = FEVAL("strrep", tauExpr, fromPrefix, toPrefix)
                %assign motionExprCtrl = FEVAL("strrep", motionExpr, fromPrefix, toPrefix)
                %if controlMode == 7 || controlMode == 8
                    %assign elbowExprCtrl = FEVAL("strrep", elbowExpr, fromPrefix, toPrefix)
                %endif
            %endif

            /* Initialize controller model state (atomic Controller subsystem).
             *
             * We use LibGetSystemField with "FcnInfo" records to get the properly
             * mangled function names. This is critical for ERT targets where identifier
             * length limits cause additional truncation beyond what's stored in
             * InitializeFcn/EnableFcn fields.
             */
            %assign ctrlSys = ::CompiledModel.System[ctrlSysIdx]
            
            %% Try Initialize first, fall back to SystemInitialize
            %assign hasInitialize = TLC_FALSE
            %if LibIsSystemField(ctrlSys, "InitializeFcnInfo")
                %assign initFcnInfo = LibGetSystemField(ctrlSys, "InitializeFcnInfo")
                %if !LibIsEqual(initFcnInfo, "")
                    %assign hasInitialize = TLC_TRUE
                    franka_controller_model.%<initFcnInfo.Name>();
                %endif
            %endif
            %if !hasInitialize && LibIsSystemField(ctrlSys, "SystemInitializeFcnInfo")
                %assign sysInitFcnInfo = LibGetSystemField(ctrlSys, "SystemInitializeFcnInfo")
                %if !LibIsEqual(sysInitFcnInfo, "")
                    franka_controller_model.%<sysInitFcnInfo.Name>();
                %endif
            %endif
            
            %% Enable function (if exists)
            %if LibIsSystemField(ctrlSys, "EnableFcnInfo")
                %assign enableFcnInfo = LibGetSystemField(ctrlSys, "EnableFcnInfo")
                %if !LibIsEqual(enableFcnInfo, "")
                    franka_controller_model.%<enableFcnInfo.Name>();
                %endif
            %endif

            /* Set output pointers (robot state + model data + dt_sec) */
            %<ctxName>.setStateOutputPointer(
                reinterpret_cast<FrankaRobotStateBus*>(%<stateExprCtrl>)
            );
            %<ctxName>.setModelOutputPointer(
                reinterpret_cast<FrankaModelDataBus*>(%<modelExprCtrl>)
            );
            %<ctxName>.setDtOutputPointer(%<dtExprCtrl>);
            
            /* Set settings input pointer (applied on enable rising edge) */
            %<ctxName>.setSettingsInputPointer(
                reinterpret_cast<const FrankaRobotSettingsBus*>(%<settingsExprCtrl>)
            );
            
            /* Set input pointers (mode-specific) */
            %switch controlMode
                %% Single-callback modes (0-4)
                %case 0  %% Torques
                    %<ctxName>.setTorqueInputPointer(%<cmdExprCtrl>);
                    %break
                %case 1  %% JointPositions
                    %<ctxName>.setJointPositionInputPointer(%<cmdExprCtrl>);
                    %break
                %case 2  %% JointVelocities
                    %<ctxName>.setJointVelocityInputPointer(%<cmdExprCtrl>);
                    %break
                %case 3  %% CartesianPose
                    %<ctxName>.setCartesianPoseInputPointer(%<cmdExprCtrl>, %<elbowExprCtrl>);
                    %break
                %case 4  %% CartesianVelocities
                    %<ctxName>.setCartesianVelocityInputPointer(%<cmdExprCtrl>, %<elbowExprCtrl>);
                    %break
                %% Dual-callback modes (5-8)
                %case 5  %% Torques + JointPositions
                    %<ctxName>.setTorquesJointPositionInputPointers(%<tauExprCtrl>, %<motionExprCtrl>);
                    %break
                %case 6  %% Torques + JointVelocities
                    %<ctxName>.setTorquesJointVelocityInputPointers(%<tauExprCtrl>, %<motionExprCtrl>);
                    %break
                %case 7  %% Torques + CartesianPose
                    %<ctxName>.setTorquesCartesianPoseInputPointers(%<tauExprCtrl>, %<motionExprCtrl>, %<elbowExprCtrl>);
                    %break
                %case 8  %% Torques + CartesianVelocities
                    %<ctxName>.setTorquesCartesianVelocityInputPointers(%<tauExprCtrl>, %<motionExprCtrl>, %<elbowExprCtrl>);
                    %break
            %endswitch
        %else
            /* In nonreusable function packaging, use generated block signals directly. */
            %<ctxName>.setStateOutputPointer(
                reinterpret_cast<FrankaRobotStateBus*>(%<stateExpr>)
            );
            %<ctxName>.setModelOutputPointer(
                reinterpret_cast<FrankaModelDataBus*>(%<modelExpr>)
            );
            %<ctxName>.setDtOutputPointer(%<dtExpr>);
            
            /* Set settings input pointer (applied on enable rising edge) */
            %<ctxName>.setSettingsInputPointer(
                reinterpret_cast<const FrankaRobotSettingsBus*>(%<settingsExpr>)
            );
            
            /* Set input pointers (mode-specific) */
            %switch controlMode
                %% Single-callback modes (0-4)
                %case 0  %% Torques
                    %<ctxName>.setTorqueInputPointer(%<cmdExpr>);
                    %break
                %case 1  %% JointPositions
                    %<ctxName>.setJointPositionInputPointer(%<cmdExpr>);
                    %break
                %case 2  %% JointVelocities
                    %<ctxName>.setJointVelocityInputPointer(%<cmdExpr>);
                    %break
                %case 3  %% CartesianPose
                    %<ctxName>.setCartesianPoseInputPointer(%<cmdExpr>, %<elbowExpr>);
                    %break
                %case 4  %% CartesianVelocities
                    %<ctxName>.setCartesianVelocityInputPointer(%<cmdExpr>, %<elbowExpr>);
                    %break
                %% Dual-callback modes (5-8)
                %case 5  %% Torques + JointPositions
                    %<ctxName>.setTorquesJointPositionInputPointers(%<tauExpr>, %<motionExpr>);
                    %break
                %case 6  %% Torques + JointVelocities
                    %<ctxName>.setTorquesJointVelocityInputPointers(%<tauExpr>, %<motionExpr>);
                    %break
                %case 7  %% Torques + CartesianPose
                    %<ctxName>.setTorquesCartesianPoseInputPointers(%<tauExpr>, %<motionExpr>, %<elbowExpr>);
                    %break
                %case 8  %% Torques + CartesianVelocities
                    %<ctxName>.setTorquesCartesianVelocityInputPointers(%<tauExpr>, %<motionExpr>, %<elbowExpr>);
                    %break
            %endswitch
        %endif
    %endif
    
    /* Initialize DWork state (for edge detection in main model). */
    %<LibBlockDWork(PrevEnable, "", "", 0)> = 0.0;
    %<LibBlockDWork(PrevErrorRecovery, "", "", 0)> = 0.0;
    %<LibBlockDWork(PrevReadOnce, "", "", 0)> = 0.0;
}
%endfunction

%% ========================================================================
%% Outputs - Called by Simulink scheduler (for enable/disable handling)
%% The actual 1kHz control happens inside robot.control(), not here
%% ========================================================================
%function Outputs(block, system) Output
{
    %assign ctxName = "franka_ctx_" + FEVAL("num2str", block.BlockIdx[0]) + "_" + FEVAL("num2str", block.BlockIdx[2])
    /* Franka Robot Block */
    
    /* Get inputs */
    real_T enable = %<LibBlockInputSignal(0, "", "", 0)>;
    real_T error_recovery = %<LibBlockInputSignal(3, "", "", 0)>;
    real_T read_once = %<LibBlockInputSignal(4, "", "", 0)>;
    
    /* Get previous values */
    real_T prev_enable = %<LibBlockDWork(PrevEnable, "", "", 0)>;
    real_T prev_error_recovery = %<LibBlockDWork(PrevErrorRecovery, "", "", 0)>;
    real_T prev_read_once = %<LibBlockDWork(PrevReadOnce, "", "", 0)>;
    
    /* Edge detection */
    bool enable_rising = (enable > 0.5) && (prev_enable <= 0.5);
    bool enable_falling = (enable <= 0.5) && (prev_enable > 0.5);
    bool error_recovery_rising = (error_recovery > 0.5) && (prev_error_recovery <= 0.5);
    bool read_once_rising = (read_once > 0.5) && (prev_read_once <= 0.5);
    
    /* Update previous values for error_recovery and read_once (unconditional) */
    %<LibBlockDWork(PrevErrorRecovery, "", "", 0)> = error_recovery;
    %<LibBlockDWork(PrevReadOnce, "", "", 0)> = read_once;
    
    /* Helper: Extract robot IP from input port */
    auto extractRobotIP = [&]() -> std::string {
        const uint8_T* robot_ip_u8 = reinterpret_cast<const uint8_T*>(
            %<LibBlockInputSignalAddr(1, "", "", 0)>
        );
        char robot_ip_buf[17];
        std::memcpy(robot_ip_buf, robot_ip_u8, 16);
        robot_ip_buf[16] = '\0';

        /* Trim trailing whitespace (common with tunable string conversions). */
        int ip_len = 0;
        while (ip_len < 16 && robot_ip_buf[ip_len] != '\0') {
            ++ip_len;
        }
        while (ip_len > 0 &&
               (robot_ip_buf[ip_len - 1] == ' ' ||
                robot_ip_buf[ip_len - 1] == '\t' ||
                robot_ip_buf[ip_len - 1] == '\r' ||
                robot_ip_buf[ip_len - 1] == '\n')) {
            robot_ip_buf[ip_len - 1] = '\0';
            --ip_len;
        }
        return std::string(robot_ip_buf);
    };
    
    /* Helper: Ensure context is initialized */
    auto ensureInitialized = [&]() -> bool {
        if (%<ctxName>.isInitialized()) {
            return true;
        }
        try {
            %<ctxName>.initialize(extractRobotIP());
            return true;
        } catch (const franka::Exception& e) {
            std::cerr << "FrankaRobotContext: failed to connect: " << e.what() << std::endl;
            return false;
        }
    };
    
    /* ====================================================================
     * Handle error_recovery trigger (only when NOT in control)
     * ==================================================================== */
    if (error_recovery_rising && !%<ctxName>.isControlRunning()) {
        if (ensureInitialized()) {
            /* Use the manager API for error recovery (operates on shared instance) */
            std::string ip = extractRobotIP();
            FrankaRobotManager::automaticErrorRecovery(ip);
            
            /* Also update state outputs so user can see the result */
            FrankaRobotManager::readOnce(ip,
                reinterpret_cast<FrankaRobotStateBus*>(%<LibBlockOutputSignalAddr(1, "", "", 0)>),
                reinterpret_cast<FrankaModelDataBus*>(%<LibBlockOutputSignalAddr(2, "", "", 0)>));
        }
    }
    
    /* ====================================================================
     * Handle read_once trigger (only when NOT in control)
     * ==================================================================== */
    if (read_once_rising && !%<ctxName>.isControlRunning()) {
        if (ensureInitialized()) {
            /* Use the manager API for readOnce (operates on shared instance) */
            std::string ip = extractRobotIP();
            FrankaRobotManager::readOnce(ip,
                reinterpret_cast<FrankaRobotStateBus*>(%<LibBlockOutputSignalAddr(1, "", "", 0)>),
                reinterpret_cast<FrankaModelDataBus*>(%<LibBlockOutputSignalAddr(2, "", "", 0)>));
        }
    }
    
    /* ====================================================================
     * Handle enable state transitions
     * 
     * IMPORTANT: For cascaded control with multiple blocks targeting the
     * same robot, we need to handle the case where:
     *   1. Block A is running control
     *   2. Block B's enable goes high (rising edge)
     *   3. Block B tries to start but fails (robot busy)
     *   4. Block A finishes
     *   5. Block B should now start
     * 
     * To support this, we:
     *   - Check if enable is high AND this context is not running
     *   - Check if the shared robot instance is available via manager
     *   - Only consume the rising edge (update prev_enable) when we
     *     successfully start OR when control is already running
     * ==================================================================== */
    if ((enable > 0.5) && !%<ctxName>.isControlRunning()) {
        if (ensureInitialized()) {
            /* Check if the shared robot instance is available (not controlled by another context) */
            std::string ip = extractRobotIP();
            if (!FrankaRobotManager::isControlRunning(ip)) {
                /* Robot is available - start control */
                %<ctxName>.startControl();
                /* Mark that we've handled the enable (consume rising edge) */
                %<LibBlockDWork(PrevEnable, "", "", 0)> = enable;
            }
            /* else: Robot is busy (another context has control).
             * Do NOT update prev_enable so we retry on next step. */
        } else {
            /* Failed to initialize - update prev_enable to avoid spamming connection attempts */
            %<LibBlockDWork(PrevEnable, "", "", 0)> = enable;
        }
    }
    else if (enable_falling && %<ctxName>.isControlRunning()) {
        /* Request stop on falling edge (graceful) */
        %<ctxName>.requestStop();
        %<LibBlockDWork(PrevEnable, "", "", 0)> = enable;
    }
    else {
        /* Normal case: not starting or stopping, just track enable state */
        %<LibBlockDWork(PrevEnable, "", "", 0)> = enable;
    }
}
%endfunction

%% ========================================================================
%% Terminate - Cleanup code
%% ========================================================================
%function Terminate(block, system) Output
{
    %assign ctxName = "franka_ctx_" + FEVAL("num2str", block.BlockIdx[0]) + "_" + FEVAL("num2str", block.BlockIdx[2])
    
    /* Shutdown this context's control thread */
    %<ctxName>.shutdown();
    
    /* Cleanup shared robot instances via manager.
     * This is idempotent - safe to call from multiple blocks.
     * First call stops all robots and clears the registry.
     * Subsequent calls are no-ops (registry already empty).
     */
    FrankaRobotManager::shutdownAll();
}
%endfunction
