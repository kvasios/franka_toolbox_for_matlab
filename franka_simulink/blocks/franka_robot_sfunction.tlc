%%  Copyright (c) 2025 Franka Robotics GmbH
%%  Franka Robot Block - TLC Implementation
%%
%%  This TLC generates code where the libfranka control callback
%%  directly executes the function-call subsystem (user's controller).
%%
%%  robot_ip is provided via input port 1 (not as a parameter).
%%
%implements "franka_robot_sfunction" "C"

%% ========================================================================
%% BlockTypeSetup - Called once per block type
%% ========================================================================
%function BlockTypeSetup(block, system) void
    %<LibAddToCommonIncludes("franka_robot_api.h")>
    %<LibAddToCommonIncludes("<type_traits>")>
%endfunction

%% ========================================================================
%% BlockInstanceSetup - Called once per block instance
%% Declares global variables
%% ========================================================================
%function BlockInstanceSetup(block, system) Output
{
    %openfile buffer
    
    /* Franka Robot Context (per block instance).
     *
     * IMPORTANT:
     * Do NOT use a single global context for the whole model, because multiple
     * Franka Robot block instances would then overwrite each other's callback,
     * I/O pointers, and control thread state — causing very erratic behavior.
     */
    %assign ctxName = "franka_ctx_" + FEVAL("num2str", block.BlockIdx[0]) + "_" + FEVAL("num2str", block.BlockIdx[2])
    FrankaRobotContext %<ctxName>;

    %closefile buffer
    %<LibCacheGlobalPrmData(buffer)>
}
%endfunction

%% ========================================================================
%% Start - Initialization code
%% ========================================================================
%function Start(block, system) Output
{
    %assign ctxName = "franka_ctx_" + FEVAL("num2str", block.BlockIdx[0]) + "_" + FEVAL("num2str", block.BlockIdx[2])
    /* Initialize Franka Robot Context
     * robot_ip comes from input port 1 as ASCII string (null-terminated)
     */
    %<ctxName>.initialize(reinterpret_cast<const char*>(%<LibBlockInputSignalAddr(1, "", "", 0)>));

    /* Resolve the function-call subsystem entry-point we should invoke from the
     * libfranka 1kHz callback.
     */
    %assign callIdx = 0
    %assign recIdx = block.SFcnSystemOutputCallMappingInfo[callIdx].StartingIdx
    %assign dstSSBlk = LibGetFcnCallBlock(block, recIdx)
    %if !LibIsEqual(dstSSBlk, "")
        %with dstSSBlk
            %assign ctrlSysIdx = LibBlockParamSetting("Subsystem", "SystemIdx")
        %endwith

        %assign ctrlFcnName = ::CompiledModel.System[ctrlSysIdx].OutputUpdateFcn
        %if LibIsEqual(ctrlFcnName, "none")
            %assign ctrlFcnName = ""
        %endif
        %if !LibIsEqual(ctrlFcnName, "")
            %if GenerateClassInterface
                /* C++ class interface packaging:
                 * Create a dedicated controller model object that is ONLY touched by
                 * the libfranka 1kHz control thread. This avoids races with the main
                 * scheduler running the top-level model (enable/disable, logging, etc.).
                 */
                using FrankaControllerModelT = std::remove_reference<decltype(*this)>::type;
                static FrankaControllerModelT franka_controller_model;

                /* Initialize controller-model timing/state. The dedicated controller
                 * instance is NOT run by the Simulink scheduler, so we explicitly
                 * initialize its timing fields and advance its timebase in the callback.
                 */
                {
                    auto* rtm = franka_controller_model.getRTM();
                    rtm->Timing.stepSize0 = 0.001;  /* 1kHz nominal */
                    rtm->Timing.taskTime0 = 0.0;
                    rtm->Timing.clockTick0 = 0U;
                    rtm->Timing.clockTickH0 = 0U;
                    rtm->Timing.stopRequestedFlag = false;
                    rtm->Timing.tFinal = -1;
                    rtm->errorStatus = nullptr;
                }

                %<ctxName>.setControllerCallback(
                    +[](void* user_data, double dt_sec) {
                        auto ctrl = static_cast<decltype(this)>(user_data);

                        /* Advance controller-model timebase FIRST (libfranka convention). */
                        {
                            auto* rtm = ctrl->getRTM();
                            if (dt_sec > 0.0) {
                                rtm->Timing.taskTime0 += dt_sec;
                            }
                            if (!(++rtm->Timing.clockTick0)) {
                                ++rtm->Timing.clockTickH0;
                            }
                        }

                        /* Now run the controller with the updated time */
                        ctrl->%<ctrlFcnName>();
                    },
                    &franka_controller_model
                );
            %else
                /* Nonreusable function packaging (External Mode friendly):
                 *
                 * There is no model object / 'this' context. The controller entry-point
                 * is a normal function that operates on the generated global model data.
                 *
                 * IMPORTANT: We do NOT manually advance the model timebase here because
                 * the main scheduler already advances the global RTM timing each step.
                 * Advancing it here would double-count time.
                 */
                %<ctxName>.setControllerCallback(
                    +[](void* /*user_data*/, double /*dt_sec*/) {
                        %<ctrlFcnName>();
                    },
                    nullptr
                );
            %endif
        %endif
        %if LibIsEqual(ctrlFcnName, "")
            /*
             * ERROR: Could not resolve a callable entry point for the function-call subsystem.
             *
             * Simulink may report OutputUpdateFcn as "none" when the targeted subsystem
             * is inlined or otherwise not generated as a callable function.
             *
             * Fix in model:
             * - Ensure the function-call subsystem is atomic and generates a callable function
             *   (not fully inlined into step).
             */
            #error "franka_robot: could not resolve function-call subsystem entry point (OutputUpdateFcn='none'). Make the Controller subsystem callable (not inlined)."
        %endif

        /* Wire Franka <-> Simulink signals. */
        %assign bsMember = "%<::CompiledModel.Name>_B"
        %assign qExpr  = "%<LibBlockOutputSignalAddr(1, "", "", 0)>"
        %assign dqExpr = "%<LibBlockOutputSignalAddr(2, "", "", 0)>"
        %assign dtExpr = "%<LibBlockOutputSignalAddr(3, "", "", 0)>"
        %assign tauExpr = "%<LibBlockInputSignalAddr(2, "", "", 0)>"

        %if GenerateClassInterface
            /* In class interface packaging, redirect I/O to the dedicated controller object. */
            %assign fromPrefix = "&%<bsMember>."
            %assign toPrefix = "&franka_controller_model.%<bsMember>."
            %assign qExprCtrl = FEVAL("strrep", qExpr, fromPrefix, toPrefix)
            %assign dqExprCtrl = FEVAL("strrep", dqExpr, fromPrefix, toPrefix)
            %assign dtExprCtrl = FEVAL("strrep", dtExpr, fromPrefix, toPrefix)
            %assign tauExprCtrl = FEVAL("strrep", tauExpr, fromPrefix, toPrefix)

            /* Initialize controller model state (atomic Controller subsystem). */
            %assign ctrlInitFcn = ""
            %assign ctrlEnableFcn = ""
            %assign ctrlSysInitFcn = ""
            %if ISFIELD(::CompiledModel.System[ctrlSysIdx], "InitializeFcn")
                %assign ctrlInitFcn = ::CompiledModel.System[ctrlSysIdx].InitializeFcn
            %endif
            %if ISFIELD(::CompiledModel.System[ctrlSysIdx], "SystemInitializeFcn")
                %assign ctrlSysInitFcn = ::CompiledModel.System[ctrlSysIdx].SystemInitializeFcn
            %endif
            %if ISFIELD(::CompiledModel.System[ctrlSysIdx], "EnableFcn")
                %assign ctrlEnableFcn = ::CompiledModel.System[ctrlSysIdx].EnableFcn
            %endif
            %if FEVAL("strncmp", ctrlInitFcn, "none", 4)
                %assign ctrlInitFcn = ""
            %endif
            %if FEVAL("strncmp", ctrlSysInitFcn, "none", 4)
                %assign ctrlSysInitFcn = ""
            %endif
            %if FEVAL("strncmp", ctrlEnableFcn, "none", 4)
                %assign ctrlEnableFcn = ""
            %endif
            %if !LibIsEqual(ctrlInitFcn, "")
                franka_controller_model.%<ctrlInitFcn>();
            %endif
            %if LibIsEqual(ctrlInitFcn, "") && !LibIsEqual(ctrlSysInitFcn, "")
                franka_controller_model.%<ctrlSysInitFcn>();
            %endif
            %if !LibIsEqual(ctrlEnableFcn, "")
                franka_controller_model.%<ctrlEnableFcn>();
            %endif

            %<ctxName>.setOutputPointers(
                %<qExprCtrl>,   /* q [7] */
                %<dqExprCtrl>,  /* dq [7] */
                %<dtExprCtrl>   /* dt_sec [1] */
            );
            %<ctxName>.setInputPointers(
                %<tauExprCtrl>  /* tau_J_d [7] */
            );
        %else
            /* In nonreusable function packaging, just use the generated block signals directly. */
            %<ctxName>.setOutputPointers(
                %<qExpr>,   /* q [7] */
                %<dqExpr>,  /* dq [7] */
                %<dtExpr>   /* dt_sec [1] */
            );
            %<ctxName>.setInputPointers(
                %<tauExpr>  /* tau_J_d [7] */
            );
        %endif
    %endif
    
    /* Initialize DWork state (for enable edge detection in main model). */
    %<LibBlockDWork(PrevEnable, "", "", 0)> = 0.0;
}
%endfunction

%% ========================================================================
%% Outputs - Called by Simulink scheduler (for enable/disable handling)
%% The actual 1kHz control happens inside robot.control(), not here
%% ========================================================================
%function Outputs(block, system) Output
{
    %assign ctxName = "franka_ctx_" + FEVAL("num2str", block.BlockIdx[0]) + "_" + FEVAL("num2str", block.BlockIdx[2])
    /* Franka Robot Block */
    
    /* Get enable input */
    real_T enable = %<LibBlockInputSignal(0, "", "", 0)>;
    real_T prev_enable = %<LibBlockDWork(PrevEnable, "", "", 0)>;
    
    /* Edge detection */
    bool rising_edge = (enable > 0.5) && (prev_enable <= 0.5);
    bool falling_edge = (enable <= 0.5) && (prev_enable > 0.5);
    
    /* Update previous enable */
    %<LibBlockDWork(PrevEnable, "", "", 0)> = enable;
    
    /* Handle state transitions */
    if (rising_edge && !%<ctxName>.isControlRunning()) {
        /* Start control loop on rising edge */
        %<ctxName>.startControl();
    }
    else if (falling_edge && %<ctxName>.isControlRunning()) {
        /* Request stop on falling edge (graceful) */
        %<ctxName>.requestStop();
    }
}
%endfunction

%% ========================================================================
%% Terminate - Cleanup code
%% ========================================================================
%function Terminate(block, system) Output
{
    %assign ctxName = "franka_ctx_" + FEVAL("num2str", block.BlockIdx[0]) + "_" + FEVAL("num2str", block.BlockIdx[2])
    /* Shutdown Franka control */
    %<ctxName>.shutdown();
}
%endfunction
