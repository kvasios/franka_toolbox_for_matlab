%% Copyright (c) 2025 Franka Robotics GmbH
%% Franka Robot Model: Gravity Vector Computation
%%
%% Computes the gravity compensation torques g(q) using libfranka's Model class
%% via FrankaRobotManager. The robot connection is shared with other
%% blocks targeting the same IP.
%%
%% Works both standalone and under function-called subsystems.
%%
%implements "franka_robot_model_gravity_sfunction" "C"

%% ========================================================================
%% BlockTypeSetup - Called once per block type
%% ========================================================================
%function BlockTypeSetup(block, system) void
    %<LibAddToCommonIncludes("franka_robot_api.h")>
    %<LibAddToCommonIncludes("<cstring>")>
    %<LibAddToCommonIncludes("<string>")>
%endfunction

%% ========================================================================
%% Start - Initialization code
%% ========================================================================
%function Start(block, system) Output
{
    /* franka_robot_model_gravity_sfunction: Initialization
     * 
     * The robot connection is managed lazily by FrankaRobotManager.
     */
}
%endfunction

%% ========================================================================
%% Outputs - Compute gravity vector
%% ========================================================================
%function Outputs(block, system) Output
{
    %% Extract parameters from SFcnParamSettings (written by mdlRTW)
    %assign use_custom_gravity = SFcnParamSettings.use_custom_gravity
    
    /* franka_robot_model_gravity_sfunction: Compute gravity compensation torques g(q)
     * Custom gravity: %<use_custom_gravity>
     * 
     * Inputs:
     *   Port 0: robot_ip (16x1 uint8) - Robot IP address
     *   Port 1: q (7x1) - Joint positions
     *   Port 2: m_total (1x1) - Total load mass
     *   Port 3: F_x_Ctotal (3x1) - Total load CoM
     %if use_custom_gravity
     *   Port 4: gravity_earth (3x1) - Custom gravity vector
     %endif
     * 
     * Output:
     *   Port 0: gravity (7x1) - Gravity compensation torques [Nm]
     */
    
    /* Extract robot IP from input port */
    const uint8_T* robot_ip_u8 = %<LibBlockInputSignalAddr(0, "", "", 0)>;
    char robot_ip_buf[17];
    std::memcpy(robot_ip_buf, robot_ip_u8, 16);
    robot_ip_buf[16] = '\0';
    std::string robot_ip(robot_ip_buf);
    
    const double* q = %<LibBlockInputSignalAddr(1, "", "", 0)>;
    double m_total = *%<LibBlockInputSignalAddr(2, "", "", 0)>;
    const double* F_x_Ctotal = %<LibBlockInputSignalAddr(3, "", "", 0)>;
    double* gravity_out = %<LibBlockOutputSignalAddr(0, "", "", 0)>;
    
    %if use_custom_gravity
        const double* gravity_earth = %<LibBlockInputSignalAddr(4, "", "", 0)>;
    %else
        const double* gravity_earth = nullptr;  /* Use default {0, 0, -9.81} */
    %endif
    
    /* Compute gravity vector via FrankaRobotManager */
    if (!FrankaRobotManager::computeGravity(robot_ip,
                                             q, m_total, F_x_Ctotal, gravity_earth,
                                             gravity_out)) {
        /* Connection failed or computation error - zero output */
        std::memset(gravity_out, 0, 7 * sizeof(double));
    }
}
%endfunction

%% ========================================================================
%% Terminate - Cleanup
%% ========================================================================
%function Terminate(block, system) Output
{
    /* franka_robot_model_gravity_sfunction: Terminate - cleanup handled by FrankaRobotManager::shutdownAll() */
}
%endfunction
