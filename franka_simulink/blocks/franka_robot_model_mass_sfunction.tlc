%% Copyright (c) 2025 Franka Robotics GmbH
%% Franka Robot Model: Mass Matrix Computation
%%
%% Computes the 7x7 mass matrix M(q) using libfranka's Model class
%% via FrankaRobotManager. The robot connection is shared with other
%% blocks targeting the same IP.
%%
%% Works both standalone and under function-called subsystems.
%%
%implements "franka_robot_model_mass_sfunction" "C"

%% ========================================================================
%% BlockTypeSetup - Called once per block type
%% ========================================================================
%function BlockTypeSetup(block, system) void
    %<LibAddToCommonIncludes("franka_robot_api.h")>
    %<LibAddToCommonIncludes("<cstring>")>
%endfunction

%% ========================================================================
%% Start - Initialization code
%% ========================================================================
%function Start(block, system) Output
{
    /* franka_robot_model_mass: Initialization
     * 
     * The robot connection is managed lazily by FrankaRobotManager.
     * getOrCreate() will connect on first call, subsequent calls reuse
     * the existing connection.
     */
}
%endfunction

%% ========================================================================
%% Outputs - Compute mass matrix
%% ========================================================================
%function Outputs(block, system) Output
{
    %% Extract robot_ip parameter
    %assign robot_ip = FEVAL("erase", ParamSettings.robot_ip, "'")
    %assign robot_ip = FEVAL("strtrim", robot_ip)
    
    /* franka_robot_model_mass: Compute mass matrix M(q)
     * Robot IP: %<robot_ip>
     * 
     * Inputs:
     *   Port 0: q (7x1) - Joint positions
     *   Port 1: I_total (9x1) - Total load inertia (3x3 col-major)
     *   Port 2: m_total (1x1) - Total load mass
     *   Port 3: F_x_Ctotal (3x1) - Total load CoM
     * 
     * Output:
     *   Port 0: mass (7x7) - Mass matrix M(q)
     */
    
    const double* q = %<LibBlockInputSignalAddr(0, "", "", 0)>;
    const double* I_total = %<LibBlockInputSignalAddr(1, "", "", 0)>;
    double m_total = *%<LibBlockInputSignalAddr(2, "", "", 0)>;
    const double* F_x_Ctotal = %<LibBlockInputSignalAddr(3, "", "", 0)>;
    double* mass_out = %<LibBlockOutputSignalAddr(0, "", "", 0)>;
    
    /* Compute mass matrix via FrankaRobotManager.
     * This will:
     * 1. Get or create the robot connection (thread-safe, shared)
     * 2. Call libfranka Model::mass() with the provided parameters
     * 3. Copy results to output
     * 
     * If connection fails, outputs will be zeroed.
     */
    if (!FrankaRobotManager::computeMass("%<robot_ip>",
                                          q, I_total, m_total, F_x_Ctotal,
                                          mass_out)) {
        /* Connection failed or computation error - zero output */
        std::memset(mass_out, 0, 49 * sizeof(double));
    }
}
%endfunction

%% ========================================================================
%% Terminate - Cleanup (handled by FrankaRobotManager::shutdownAll)
%% ========================================================================
%function Terminate(block, system) Output
{
    /* franka_robot_model_mass: Terminate
     * 
     * Cleanup is handled globally by FrankaRobotManager::shutdownAll()
     * which is called by franka_robot_sfunction's Terminate function.
     * This ensures proper cleanup order and prevents double-free.
     */
}
%endfunction
