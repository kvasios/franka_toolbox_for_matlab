%% Copyright (c) 2025 Franka Robotics GmbH
%% Franka Robot Model: Forward Kinematics Pose Computation
%%
%% Computes the 4x4 pose transformation using libfranka's Model class
%% via FrankaRobotManager. The robot connection is shared with other
%% blocks targeting the same IP.
%%
%% Works both standalone and under function-called subsystems.
%%
%implements "franka_robot_model_pose_sfunction" "C"

%% ========================================================================
%% BlockTypeSetup - Called once per block type
%% ========================================================================
%function BlockTypeSetup(block, system) void
    %<LibAddToCommonIncludes("franka_robot_api.h")>
    %<LibAddToCommonIncludes("<cstring>")>
%endfunction

%% ========================================================================
%% Start - Initialization code
%% ========================================================================
%function Start(block, system) Output
{
    /* franka_robot_model_pose: Initialization
     * 
     * The robot connection is managed lazily by FrankaRobotManager.
     */
}
%endfunction

%% ========================================================================
%% Outputs - Compute forward kinematics pose
%% ========================================================================
%function Outputs(block, system) Output
{
    %% Extract parameters
    %assign robot_ip = FEVAL("erase", ParamSettings.robot_ip, "'")
    %assign robot_ip = FEVAL("strtrim", robot_ip)
    %assign frame = ParamSettings.frame[0][0]
    
    /* franka_robot_model_pose: Compute forward kinematics pose
     * Robot IP: %<robot_ip>
     * Frame: %<frame> (0-6=Joint1-7, 7=Flange, 8=EndEffector, 9=Stiffness)
     * 
     * Inputs:
     *   Port 0: q (7x1) - Joint positions
     *   Port 1: F_T_EE (16x1) - End effector in flange frame
     *   Port 2: EE_T_K (16x1) - Stiffness frame in EE frame
     * 
     * Output:
     *   Port 0: pose (4x4) - Pose transformation matrix
     */
    
    const double* q = %<LibBlockInputSignalAddr(0, "", "", 0)>;
    const double* F_T_EE = %<LibBlockInputSignalAddr(1, "", "", 0)>;
    const double* EE_T_K = %<LibBlockInputSignalAddr(2, "", "", 0)>;
    double* pose_out = %<LibBlockOutputSignalAddr(0, "", "", 0)>;
    
    /* Compute pose via FrankaRobotManager */
    if (!FrankaRobotManager::computePose("%<robot_ip>",
                                          %<frame>,
                                          q, F_T_EE, EE_T_K,
                                          pose_out)) {
        /* Connection failed or computation error - output identity matrix */
        std::memset(pose_out, 0, 16 * sizeof(double));
        pose_out[0] = 1.0;   /* R(0,0) */
        pose_out[5] = 1.0;   /* R(1,1) */
        pose_out[10] = 1.0;  /* R(2,2) */
        pose_out[15] = 1.0;  /* Homogeneous row */
    }
}
%endfunction

%% ========================================================================
%% Terminate - Cleanup
%% ========================================================================
%function Terminate(block, system) Output
{
    /* franka_robot_model_pose: Terminate - cleanup handled by FrankaRobotManager::shutdownAll() */
}
%endfunction
