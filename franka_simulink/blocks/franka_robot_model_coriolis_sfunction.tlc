%% Copyright (c) 2025 Franka Robotics GmbH
%% Franka Robot Model: Coriolis Force Vector Computation
%%
%% Computes the Coriolis force vector c(q,dq) using libfranka's Model class
%% via FrankaRobotManager. The robot connection is shared with other
%% blocks targeting the same IP.
%%
%% Works both standalone and under function-called subsystems.
%%
%implements "franka_robot_model_coriolis_sfunction" "C"

%% ========================================================================
%% BlockTypeSetup - Called once per block type
%% ========================================================================
%function BlockTypeSetup(block, system) void
    %<LibAddToCommonIncludes("franka_robot_api.h")>
    %<LibAddToCommonIncludes("<cstring>")>
    %<LibAddToCommonIncludes("<string>")>
%endfunction

%% ========================================================================
%% Start - Initialization code
%% ========================================================================
%function Start(block, system) Output
{
    /* franka_robot_model_coriolis_sfunction: Initialization
     * 
     * The robot connection is managed lazily by FrankaRobotManager.
     */
}
%endfunction

%% ========================================================================
%% Outputs - Compute Coriolis force vector
%% ========================================================================
%function Outputs(block, system) Output
{
    /* franka_robot_model_coriolis_sfunction: Compute Coriolis force vector c(q,dq)
     * 
     * Inputs:
     *   Port 0: robot_ip (16x1 uint8) - Robot IP address
     *   Port 1: q (7x1) - Joint positions
     *   Port 2: dq (7x1) - Joint velocities
     *   Port 3: I_total (9x1) - Total load inertia (3x3 col-major)
     *   Port 4: m_total (1x1) - Total load mass
     *   Port 5: F_x_Ctotal (3x1) - Total load CoM
     * 
     * Output:
     *   Port 0: coriolis (7x1) - Coriolis force vector [Nm]
     */
    
    /* Extract robot IP from input port */
    const uint8_T* robot_ip_u8 = %<LibBlockInputSignalAddr(0, "", "", 0)>;
    char robot_ip_buf[17];
    std::memcpy(robot_ip_buf, robot_ip_u8, 16);
    robot_ip_buf[16] = '\0';
    std::string robot_ip(robot_ip_buf);
    
    const double* q = %<LibBlockInputSignalAddr(1, "", "", 0)>;
    const double* dq = %<LibBlockInputSignalAddr(2, "", "", 0)>;
    const double* I_total = %<LibBlockInputSignalAddr(3, "", "", 0)>;
    double m_total = *%<LibBlockInputSignalAddr(4, "", "", 0)>;
    const double* F_x_Ctotal = %<LibBlockInputSignalAddr(5, "", "", 0)>;
    double* coriolis_out = %<LibBlockOutputSignalAddr(0, "", "", 0)>;
    
    /* Compute Coriolis vector via FrankaRobotManager */
    if (!FrankaRobotManager::computeCoriolis(robot_ip,
                                              q, dq, I_total, m_total, F_x_Ctotal,
                                              coriolis_out)) {
        /* Connection failed or computation error - zero output */
        std::memset(coriolis_out, 0, 7 * sizeof(double));
    }
}
%endfunction

%% ========================================================================
%% Terminate - Cleanup
%% ========================================================================
%function Terminate(block, system) Output
{
    /* franka_robot_model_coriolis_sfunction: Terminate - cleanup handled by FrankaRobotManager::shutdownAll() */
}
%endfunction
